# Copy to backend/.env. Secrets belong only in the backend.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=
YOUTUBE_API_KEY=
# Optional for public Books discovery; helps with project quota.
GOOGLE_BOOKS_API_KEY=
DATABASE_URL=sqlite:///./lessonforge.db
REQUEST_TIMEOUT=30
LLM_TIMEOUT=120
MAX_SOURCES_PER_PROVIDER=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
